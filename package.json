{
  "name": "chess-openings-trainer",
  "version": "1.0.0",
  "description": "Desktop chess openings trainer powered by Stockfish.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac-universal": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.chessopeningstrainer.app",
    "productName": "Chess Openings Trainer",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "electron/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "Chess Openings Trainer ${version}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
